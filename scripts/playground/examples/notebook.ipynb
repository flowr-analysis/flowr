   "metadata": {},
   "source": [
    "# Iris\n",
    "A look at R's built-in `iris` data."
   ]
  },
  {
   "cell_type": "code",
   "id": "cell-1",
   "metadata": {},
   "source": [
    "petal <- iris$Petal.Length\n",
    "species <- iris$Species"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "code",
   "id": "cell-2",
   "metadata": {},
   "source": [
    "means <- tapply(petal, species, mean)\n",
    "means"
   ],
   "execution_count": null,
   "outputs": []
  },
  {
   "cell_type": "markdown",
   "id": "cell-3",
   "metadata": {},
   "source": [
    "The longest petals:"
   ]
  },
  {
   "cell_type": "code",
   "id": "cell-4",
   "metadata": {},
   "source": [
    "longest <- names(which.max(means))\n",
    "print(longest)\n",
    "boxplot(petal ~ species)"
   ],
   "execution_count": null,
   "outputs": []
  }
 ],
